        "purpose": "Indirect question form."
      },
      "level": "A2",
      "competencies": [
        "eo.question-polie",
        "gram.question-indirecte"
      ],
      "instructions": "Choisissez la bonne réponse.",
      "question": "Quelle question indirecte est correcte ?",
      "options": [
        {
          "id": "a",
          "text": "« Je voudrais savoir si la piscine est ouverte le dimanche. »",
          "explanation": "Yes: « si » + indicative."
        },
        {
          "id": "b",
          "text": "« Je voudrais savoir est-ce que la piscine est ouverte. »",
          "explanation": "No « est-ce que » in indirect questions."
        },
        {
          "id": "c",
          "text": "« Je voudrais savoir la piscine est-elle ouverte. »",
          "explanation": "No inversion in indirect questions."
        },
        {
          "id": "d",
          "text": "« Je voudrais savoir que la piscine est ouverte. »",
          "explanation": "« que » doesn't ask."
        }
      ],
      "answer": "a",
      "stage": "D",
      "hint": "Indirect yes/no questions use « si »."
    },
    {
      "id": "aeo2-guide-2",
