        "eo.interaction"
      ],
      "instructions": "Choisissez la bonne réponse.",
      "question": "On vous dit que le cours est complet. Quelle réaction est la meilleure ?",
      "options": [
        {
          "id": "a",
          "text": "« Bon, au revoir. »",
          "explanation": "Ends without a solution."
        },
        {
          "id": "b",
          "text": "« Ah, c'est dommage ! Est-ce qu'il y a une liste d'attente ou un autre horaire ? »",
          "explanation": "Yes: reacts and asks for an alternative."
        },
        {
          "id": "c",
          "text": "« Ce n'est pas possible ! »",
          "explanation": "Not constructive."
        },
        {
          "id": "d",
          "text": "« D'accord. »",
          "explanation": "Misses the chance to solve it."
        }
      ],
      "answer": "b",
      "stage": "D",
      "hint": "React, then ask for an alternative."
    },
