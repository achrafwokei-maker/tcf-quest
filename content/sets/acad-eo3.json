        "eo.argumenter",
        "eo.nuancer"
      ],
      "instructions": "Choisissez la bonne réponse.",
      "question": "Quelle phrase introduit une concession ?",
      "options": [
        {
          "id": "a",
          "text": "« Certes, la voiture est pratique, mais elle pollue beaucoup. »",
          "explanation": "Yes: « Certes… mais »."
        },
        {
          "id": "b",
          "text": "« La voiture pollue. »",
          "explanation": "A plain statement."
        },
        {
          "id": "c",
          "text": "« Donc la voiture est pratique. »",
          "explanation": "« Donc » concludes."
        },
        {
          "id": "d",
          "text": "« Par exemple, ma voiture. »",
          "explanation": "An example, not a concession."
        }
      ],
      "answer": "a",
      "stage": "D",
      "hint": "Look for « certes »."
    },
