      "title": "Points de vue (120–180 mots) : la méthode",
      "stage": "B",
      "points": [
        "Une phrase d'introduction : le sujet.",
        "Reformulez le document 1 (sans copier).",
        "Reformulez le document 2 avec un connecteur d'opposition.",
        "Donnez votre opinion avec un argument et un exemple.",
        "Conclusion courte. 120 à 180 mots."
      ]
    },
    {
      "id": "aee3-exemple",
      "type": "card",
      "tcf_target": {
        "section": "EE",
        "task": "EE-T3",
        "purpose": "Strategy lesson (Académie TCF)."
      },
      "level": "B1",
      "kind": "language",
      "title": "Exemple",
      "stage": "C",
      "body": "« Le premier document affirme que le télétravail améliore la qualité de vie. En revanche, le second souligne qu'il isole les employés. Pour ma part, … »"
    },
    {
      "id": "aee3-guide-1",
      "type": "select",
      "tcf_target": {
        "section": "EE",
        "task": "EE-T3",
        "purpose": "Guided practice."
      },
      "level": "B1",
      "competencies": [
        "ee.comparer-points-de-vue"
      ],
      "instructions": "Choisissez la bonne réponse.",
      "question": "Quelle phrase reformule au lieu de copier ?",
      "options": [
        {
          "id": "a",
          "text": "Document : « Le télétravail isole. » → « Selon le second auteur, travailler chez soi coupe des collègues. »",
          "explanation": "Yes: same idea, new words."
        },
        {
          "id": "b",
          "text": "« Le télétravail isole. »",
          "explanation": "Copied."
        },
        {
          "id": "c",
          "text": "« Le document dit : “Le télétravail isole.” »",
          "explanation": "Copied in quotes."
        },
        {
          "id": "d",
          "text": "« Le télétravail, isole. »",
          "explanation": "Copied."
        }
      ],
      "answer": "a",
      "stage": "D",
      "hint": "Rephrase the documents."
    },
    {
      "id": "aee3-guide-2",
      "type": "select",
      "tcf_target": {
        "section": "EE",
        "task": "EE-T3",
        "purpose": "Guided practice."
      },
      "level": "B1",
      "competencies": [
        "ee.comparer-points-de-vue"
      ],
      "instructions": "Choisissez la bonne réponse.",
      "question": "Quel connecteur oppose les deux documents ?",
      "options": [
        {
          "id": "a",
          "text": "« En revanche »",
          "explanation": "Yes."
        },
        {
          "id": "b",
          "text": "« De plus »",
          "explanation": "Addition."
        },
        {
          "id": "c",
          "text": "« Ainsi »",
          "explanation": "Consequence."
        },
        {
          "id": "d",
          "text": "« D'abord »",
          "explanation": "Sequence."
        }
      ],
      "answer": "a",
      "stage": "D",
      "hint": "Opposition connector."
    },
    {
