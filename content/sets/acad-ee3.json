          "text": "Après avoir présenté les deux points de vue.",
          "explanation": "Yes: compare first, then give your view."
        },
        {
          "id": "b",
          "text": "Dans la première phrase uniquement.",
          "explanation": "Comparison comes first."
        },
        {
          "id": "c",
          "text": "Nulle part.",
          "explanation": "It's required."
        },
        {
          "id": "d",
          "text": "À la place du document 2.",
          "explanation": "Both documents are needed."
        }
      ],
      "answer": "a",
      "stage": "E"
    },
