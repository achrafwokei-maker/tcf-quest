      "title": "Exemple",
      "stage": "C",
      "body": "Consigne : invitez un collègue et donnez l'heure et le lieu. Un bon message cite l'heure, le lieu, demande une réponse, puis se termine par « À bientôt, Sara »."
    },
    {
      "id": "aee1-guide-1",
      "type": "select",
      "tcf_target": {
        "section": "EE",
        "task": "EE-T1",
        "purpose": "Guided practice."
      },
      "level": "B1",
      "competencies": [
        "ee.message-informer"
      ],
      "instructions": "Choisissez la bonne réponse.",
      "question": "Quelle formule convient pour écrire à votre propriétaire ?",
      "options": [
        {
          "id": "a",
          "text": "« Salut ! »",
          "explanation": "Too familiar."
        },
        {
          "id": "b",
          "text": "« Madame, Monsieur, »",
          "explanation": "Yes: formal."
        },
        {
          "id": "c",
          "text": "« Coucou ! »",
          "explanation": "Too familiar."
        },
        {
          "id": "d",
          "text": "« Yo, »",
          "explanation": "No."
        }
      ],
      "answer": "b",
      "stage": "D",
      "hint": "Formal recipient → formal greeting."
    },
    {
      "id": "aee1-guide-2",
      "type": "select",
      "tcf_target": {
        "section": "EE",
        "task": "EE-T1",
        "purpose": "Guided practice."
      },
      "level": "B1",
      "competencies": [
        "ee.message-informer"
      ],
      "instructions": "Choisissez la bonne réponse.",
      "question": "Il manque un point de la consigne (proposer une date). Quelle phrase l'ajoute ?",
      "options": [
        {
          "id": "a",
          "text": "« Je te propose samedi 14, vers 18 h. »",
          "explanation": "Yes: a concrete date."
        },
        {
          "id": "b",
          "text": "« À bientôt. »",
          "explanation": "Closing only."
        },
        {
          "id": "c",
          "text": "« Merci. »",
          "explanation": "No date."
        },
        {
          "id": "d",
          "text": "« J'espère que ça va. »",
          "explanation": "No date."
        }
      ],
      "answer": "a",
      "stage": "D",
      "hint": "Check every point."
    },
    {
