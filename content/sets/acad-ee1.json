          "id": "a",
          "text": "« Je vous prie d'agréer, Madame, mes salutations distinguées. »",
          "explanation": "Yes: formal closing."
        },
        {
          "id": "b",
          "text": "« Bisous ! »",
          "explanation": "Familiar."
        },
        {
          "id": "c",
          "text": "« Bye. »",
          "explanation": "No."
        },
        {
          "id": "d",
          "text": "« À plus. »",
          "explanation": "Familiar."
        }
      ],
      "answer": "a",
      "stage": "E"
    },
