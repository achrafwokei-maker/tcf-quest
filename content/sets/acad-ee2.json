      },
      "level": "B1",
      "competencies": [
        "ee.recit-commentaire"
      ],
      "instructions": "Choisissez la bonne réponse.",
      "question": "Quelle phrase utilise bien les temps du récit ?",
      "options": [
        {
          "id": "a",
          "text": "« Il pleuvait quand je suis sorti. »",
          "explanation": "Yes: imparfait (décor) + passé composé (action)."
        },
        {
          "id": "b",
          "text": "« Il a plu quand je sortais toujours. »",
          "explanation": "Tenses swapped."
        },
        {
          "id": "c",
          "text": "« Il pleut quand je suis sorti. »",
          "explanation": "Present doesn't fit."
        },
        {
          "id": "d",
          "text": "« Il pleuvra quand je suis sorti. »",
          "explanation": "Future doesn't fit."
        }
      ],
      "answer": "a",
      "stage": "D",
      "hint": "Imparfait for background, passé composé for actions."
    },
    {
